-- 07_High_freq_set
-- input: 03_cond_feature_extraction 

WITH high_freq AS (
    SELECT *
    FROM 03_Cond_feature_extraction
    WHERE heds_freq >= 0.05
)
SELECT 'High Frequency' AS set_type, *
FROM high_freq


