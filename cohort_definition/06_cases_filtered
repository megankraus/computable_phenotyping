-- 06_cases_filtered
--input: 05_potential_cases_demographics

-- inclusion criteria: 1 binary for cases, over age of 18, no missing sex or race information

SELECT *,
    1 as cohort
FROM 05_potential_cases_demographics
WHERE age > 18
    AND sex_concept_id <> 0
    AND race_concept_id<> 0


