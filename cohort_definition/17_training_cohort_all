-- 17_training_cohort_all
-- input: 13_stratified_train_val_split, 15_final_add_index

-- obtain only training cohort and add labels
SELECT s.*, m.index_date
FROM 13_stratified_train_val_split s
LEFT JOIN final_add_index_15 m
  ON s.person_id = m.person_id
WHERE s.split = 'train'


