-- 01_train_lasso_training_set
-- input: feature_matrix
-- lang: python 


def 01_train_lasso_training_set(feature_matrix):
    from pyspark.ml.classification import LogisticRegression
    from pyspark.ml.feature import VectorAssembler
    from pyspark.ml import Pipeline
    from pyspark.sql import SparkSession
    import pandas as pd
    import json

    spark = SparkSession.builder.getOrCreate()

    # Feature columns
    feature_cols = [c for c in feature_matrix.columns if c not in ("person_id", "cohort")]

    # Assemble features
    assembler = VectorAssembler(inputCols=feature_cols, outputCol="features")
    lasso = LogisticRegression(
    labelCol="cohort",
    featuresCol="features",
    probabilityCol="probability",
    elasticNetParam=1.0,  # L1 penalty
    regParam=0.01,         # adjust as needed for sparsity
    maxIter=100,
    standardization=True,
    tol=1e-6,
    fitIntercept=True
)

    pipeline = Pipeline(stages=[assembler, lasso])

    # Fit model
    model = pipeline.fit(feature_matrix)

    # Extract coefficients
    lr_model = model.stages[-1]
    coef_dict = dict(zip(feature_cols, lr_model.coefficients.toArray()))
    coef_json = json.dumps(coef_dict)
    feature_cols_json = json.dumps(feature_cols)

    # Return 1-row Spark DataFrame (no filesystem)
    out = spark.createDataFrame(
        [(coef_json, feature_cols_json)],
        ["coef_json", "feature_cols_json"]
    )
    return out



