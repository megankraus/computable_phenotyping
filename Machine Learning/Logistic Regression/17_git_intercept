-- 17_git_intercept
-- input: feature_matrix
-- lang: python 


def 17_git_intercept(feature_matrix):
    from pyspark.ml.classification import LogisticRegression
    from pyspark.ml.feature import VectorAssembler
    from pyspark.ml import Pipeline
    from pyspark.sql import SparkSession
    from pyspark.sql import functions as F

    spark = SparkSession.builder.getOrCreate()

    # Feature columns
    feature_cols = [c for c in feature_matrix.columns if c not in ("person_id", "cohort")]

    # Assemble features
    assembler = VectorAssembler(inputCols=feature_cols, outputCol="features")

    # Logistic Regression
    lr = LogisticRegression(labelCol="cohort", featuresCol="features", maxIter=100)

    # Pipeline
    pipeline = Pipeline(stages=[assembler, lr])

    # Fit pipeline
    model = pipeline.fit(feature_matrix)

    # Extract logistic regression stage
    lr_model = model.stages[-1]

    # ---- Make coefficients DataFrame ----
    coeff_pairs = [(str(f), float(c)) for f, c in zip(feature_cols, lr_model.coefficients.toArray())]

    coeff_df = spark.createDataFrame(coeff_pairs, ["feature", "coefficient"]) \
                    .withColumn("intercept", F.lit(float(lr_model.intercept)))

    return coeff_df



-- output: feature(ID), coefficient, intercept 
-- row: number of features
