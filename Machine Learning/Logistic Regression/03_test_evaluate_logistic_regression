-- 03_test_evaluate_logistic_regression
-- inputs: 02_apply_logistic_regression_to_test
-- lang: python 


def 03_test_evaluate_logistic_regression(02_apply_logistic_regression_to_test):
    apply_logistic_regression_to_test = 02_apply_logistic_regression_to_test
    from pyspark.ml.evaluation import BinaryClassificationEvaluator
    from pyspark.sql import functions as F

    predictions = apply_logistic_regression_to_test  # node output is the Spark DataFrame with predictions

    # Initialize evaluators
    evaluator_roc = BinaryClassificationEvaluator(labelCol="cohort", rawPredictionCol="probability", metricName="areaUnderROC")
    evaluator_pr = BinaryClassificationEvaluator(labelCol="cohort", rawPredictionCol="probability", metricName="areaUnderPR")

    # Compute metrics
    auroc = evaluator_roc.evaluate(predictions)
    auprc = evaluator_pr.evaluate(predictions)

    # Compute accuracy, precision, recall, F1 manually
    metrics = (
        predictions
        .withColumn("tp", F.when((F.col("cohort") == 1) & (F.col("prediction") == 1), 1).otherwise(0))
        .withColumn("tn", F.when((F.col("cohort") == 0) & (F.col("prediction") == 0), 1).otherwise(0))
        .withColumn("fp", F.when((F.col("cohort") == 0) & (F.col("prediction") == 1), 1).otherwise(0))
        .withColumn("fn", F.when((F.col("cohort") == 1) & (F.col("prediction") == 0), 1).otherwise(0))
    )

    summary = metrics.agg(
        F.sum("tp").alias("TP"),
        F.sum("tn").alias("TN"),
        F.sum("fp").alias("FP"),
        F.sum("fn").alias("FN")
    ).collect()[0]

    TP, TN, FP, FN = summary["TP"], summary["TN"], summary["FP"], summary["FN"]
    accuracy = (TP + TN) / (TP + TN + FP + FN)
    precision = TP / (TP + FP) if TP + FP > 0 else 0
    recall = TP / (TP + FN) if TP + FN > 0 else 0
    f1 = 2 * precision * recall / (precision + recall) if precision + recall > 0 else 0

    # Return metrics as a Spark DataFrame
    from pyspark.sql import Row
    return predictions.sql_ctx.createDataFrame([Row(
        AUROC=auroc, AUPRC=auprc, Accuracy=accuracy, Precision=precision, Recall=recall, F1=f1
    )])


-- output: AUROC, AUPRC, Accuracy, Precision, Recall, F1
