-- 16_plot_logreg_roc_with_ci_and_larger_text
-- inputs: 02_apply_logistic_regression_to_test, 09_apply_logistic_regression_to_validation
-- lang: python 


def 16_plot_logreg_roc_with_ci_and_larger_text(02_apply_logistic_regression_to_test, 09_apply_logistic_regression_to_validation, n_bootstraps=1000, random_seed=42):
    apply_logistic_regression_to_validation = 09_apply_logistic_regression_to_validation
    apply_logistic_regression_to_test = 02_apply_logistic_regression_to_test
    import matplotlib.pyplot as plt
    from sklearn.metrics import roc_curve, auc
    import numpy as np
    import pandas as pd

    val_df = apply_logistic_regression_to_validation.toPandas()
    test_df = apply_logistic_regression_to_test.toPandas()

    plt.figure(figsize=(10,6))

    rng = np.random.RandomState(random_seed)

    colors = {'Validation': 'purple', 'Training': 'red'}

    for label, df in [('Validation', val_df), ('Training', test_df)]:
        color = colors[label]
        for model in df['model_name'].unique():
            model_df = df[df['model_name'] == model]
            y_true = model_df['cohort'].values
            y_score = model_df['probability'].values

            fpr, tpr, _ = roc_curve(y_true, y_score)
            roc_auc = auc(fpr, tpr)

            bootstrapped_scores = []
            n_samples = len(y_true)
            for i in range(n_bootstraps):
                indices = rng.randint(0, n_samples, n_samples)
                if len(np.unique(y_true[indices])) < 2:
                    continue
                score = auc(*roc_curve(y_true[indices], y_score[indices])[:2])
                bootstrapped_scores.append(score)

            ci_lower = np.percentile(bootstrapped_scores, 2.5)
            ci_upper = np.percentile(bootstrapped_scores, 97.5)

            plt.plot(fpr, tpr, lw=2, color=color,
                     label=f"{model} {label} (AUC={roc_auc:.3f}, CI={ci_lower:.3f}-{ci_upper:.3f})")

    plt.plot([0,1], [0,1], color='gray', linestyle='--')
    plt.xlabel("False Positive Rate", fontsize=14)
    plt.ylabel("True Positive Rate", fontsize=14)
    plt.title("ML Logistic Regression ROC Curve Comparison", fontsize=16)
    plt.legend(loc="lower right", fontsize=12)
    plt.xticks(fontsize=12)
    plt.yticks(fontsize=12)
    plt.show()



-- output: combined ROC curve with training and validation set, FPR on x, TPR on y, title on top, legend bottom right , includes CIs and AUC
