-- 08_test_xgboost_get_feature_names
-- inputs: 07_compute_xgb_shap, patient_feature_counts (from rule-based model) 
-- lang: sql 

-- Join feature importance with feature names
SELECT
    s.feature,
    f.feature_name,
    s.mean_abs_shap
FROM compute_xgb_shap AS s
LEFT JOIN (
    SELECT DISTINCT feature_id, feature_name
    FROM patient_feature_counts
) AS f
    ON s.feature = f.feature_id


-- output: feature, feature_name, mean_abs_shap
-- rows: number in feature set 
