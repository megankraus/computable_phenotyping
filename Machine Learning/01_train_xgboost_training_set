-- train_xgboost_training_set 
-- input: feature_matrix 
-- lang: python 

def train_xgboost_training_set(feature_matrix):
    import json
    import xgboost as xgb
    import pandas as pd
    from pyspark.sql import SparkSession

    spark = SparkSession.builder.getOrCreate()

    # ---- Prepare data (to pandas) ----
    df = feature_matrix.toPandas() if not isinstance(feature_matrix, pd.DataFrame) else feature_matrix
    feature_cols = [c for c in df.columns if c not in ("person_id", "cohort")]
    X = df[feature_cols]
    y = df["cohort"]

    # ---- Train XGBoost ----
    model = xgb.XGBClassifier(
        n_estimators=500,
        max_depth=6,
        learning_rate=0.05,
        subsample=0.8,
        colsample_bytree=0.8,
        use_label_encoder=False,
        eval_metric="logloss",
        random_state=42
    )
    model.fit(X, y, verbose=False)

    # ---- Serialize model + metadata to strings (NO FILESYSTEM) ----
    booster = model.get_booster()
    model_json = booster.save_raw("json").decode("utf-8")
    feature_cols_json = json.dumps(feature_cols)
    params_json = json.dumps({
        "n_estimators": 500,
        "max_depth": 6,
        "learning_rate": 0.05,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "eval_metric": "logloss",
        "random_state": 42,
        "objective": "binary:logistic"
    })

    # ---- Return as a 1-row Spark DataFrame ----
    out = spark.createDataFrame(
        [(model_json, feature_cols_json, params_json)],
        ["model_json", "feature_cols_json", "params_json"]
    )
    return out




