-- 02_evaluate_heds_training
-- input: 01_updated_test_patient_feature_scores
-- lang: python


def 02_evaluate_heds_training(01_updated_test_patient_feature_scores, threshold=0.486):
    updated_test_patient_feature_scores = 01_updated_test_patient_feature_scores
    import pandas as pd
    import numpy as np

    # Coefficients from training set
    beta0 = -1.4582630167413744
    beta1 = 0.09353720976587945

    # Convert Spark DataFrame to pandas
    df = updated_test_patient_feature_scores.toPandas()
    df["cohort"] = df["cohort"].astype(int)

    # Compute predicted probabilities using training coefficients
    df["prob_heds"] = 1 / (1 + np.exp(-(beta0 + beta1 * df["score"])))

    # Apply threshold
    df["predicted_hEDS"] = (df["prob_heds"] >= threshold).astype(int)

    # Confusion counts
    true_positives = ((df["cohort"] == 1) & (df["predicted_hEDS"] == 1)).sum()
    false_negatives = ((df["cohort"] == 1) & (df["predicted_hEDS"] == 0)).sum()
    true_negatives = ((df["cohort"] == 0) & (df["predicted_hEDS"] == 0)).sum()
    false_positives = ((df["cohort"] == 0) & (df["predicted_hEDS"] == 1)).sum()

    # Metrics
    sensitivity = true_positives / (true_positives + false_negatives)
    specificity = true_negatives / (true_negatives + false_positives)

    # Wrap in a pandas DataFrame for Foundry
    result = pd.DataFrame({
        "true_positives": [true_positives],
        "false_negatives": [false_negatives],
        "true_negatives": [true_negatives],
        "false_positives": [false_positives],
        "sensitivity": [sensitivity],
        "specificity": [specificity],
        "beta0": [beta0],
        "beta1": [beta1]
    })

    return result

-- output: true pos, false pos, true neg, false neg, sensitivity, specificity, beta0, beta1
