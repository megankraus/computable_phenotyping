def evaluate_heds_training(updated_test_patient_feature_scores, threshold=0.486):
    updated_test_patient_feature_scores = updated_test_patient_feature_scores
    import pandas as pd
    import numpy as np

    # Coefficients from training set
    beta0 = -1.4582630167413744
    beta1 = 0.09353720976587945

    # Convert Spark DataFrame to pandas
    df = updated_test_patient_feature_scores.toPandas()
    df["cohort"] = df["cohort"].astype(int)

    # Compute predicted probabilities using training coefficients
    df["prob_heds"] = 1 / (1 + np.exp(-(beta0 + beta1 * df["score"])))
